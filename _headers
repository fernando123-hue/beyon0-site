  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/vendor/*
  Cache-Control: public, max-age=604800

# JS e CSS com cache curto (a trava da travessia, docs/testes/travessia-cache.test.mjs): com max-age=0 cada troca de página
# revalidava ~37 arquivos com o servidor antes de pintar (o vão de ~900 ms no celular). O HTML montado pede cada um com
# ?v=<hash do conteúdo> (cloudflare/montar-publico.mjs): o HTML novo nunca usa JS/CSS velho. 300 s, não um ano, porque há
# módulos pedidos por JS SEM ?v (lista fechada no teste): no pior caso, por até 5 min depois de publicar, um deles vem velho.
/js/*
  Cache-Control: public, max-age=300

/css/*
  Cache-Control: public, max-age=300

# O balão do atendente é carregado por <script> em site de OUTRA origem: só este arquivo (nunca /js/*) sai com CORP cross-origin.
# E revalida sempre (depois do /js/*, para o "! Cache-Control" tirar o cache curto): a URL é fixa no site do cliente, sem ?v,
# então uma correção do balão chega no próximo carregamento de lá
/js/atendente-balao.js
  ! Cross-Origin-Resource-Policy
  Cross-Origin-Resource-Policy: cross-origin
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate
