# ==========================================================================
# Variáveis de ambiente do site Beyon Zero — SÓ OS NOMES, NUNCA OS VALORES.
# Os valores ficam na Vercel (Settings > Environment Variables) e, na
# próxima fase, no Infisical. Nenhuma delas vai para o navegador.
# Detalhes: docs/fundacao/02-OPERACAO.md
# ==========================================================================

# Supabase — Project Settings > API Keys
SUPABASE_URL=
# chave publicável (sb_publishable_...): o backend a usa com o JWT do usuário, então o RLS vale
SUPABASE_CHAVE_PUBLICA=
# chave SECRETA (sb_secret_...): ignora o RLS. Só servidor, só métricas anônimas e tarefas do sistema
SUPABASE_CHAVE_SECRETA=

# painel de métricas (/painel): 32+ caracteres aleatórios
# node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
PAINEL_CHAVE=

# opcional: outros hosts aceitos no /api/evento, separados por vírgula (ex.: www.dominio.com.br)
METRICAS_HOSTS=

# ---------- Fase 2: agente de vendas (/orcamento) ----------
# chave da API da Anthropic (o modelo): SÓ servidor. Sem ela, a conversa responde "indisponível" e oferece o WhatsApp.
ANTHROPIC_API_KEY=

# ---------- Pagamentos: Mercado Pago (docs/pagamentos/01-ARQUITETURA-E-OPERACAO.md §2, §9, §10) ----------
# Faltou qualquer uma: pagamento online DESLIGADO (o site oferece o WhatsApp). Teste e produção NUNCA se misturam:
# na Vercel, Production exige MP_AMBIENTE=producao; Preview/Development exigem "teste".
MP_AMBIENTE=
# SECRETO, só servidor. Teste e produção começam igual (APP_USR): por isso o ambiente é declarado acima
MP_ACCESS_TOKEN=
# público (vai à página para os campos seguros do cartão)
MP_PUBLIC_KEY=
# SECRETO: a "assinatura secreta" do webhook (painel do MP › Webhooks), uma por modo (teste/produção)
MP_WEBHOOK_SEGREDO=
# a conta Mercado Pago da Beyon Zero (número): toda order consultada tem de ser dela, e o token também. Obrigatório (teste e produção)
MP_USER_ID=
# 3DS: vazio (desligado) ou on_fraud_risk — só depois de testar um desafio no ambiente de TESTE
MP_3DS=
# SECRETO, 32+ caracteres: autoriza as rotinas diárias, a reconciliação de pagamentos e a retenção de 90 dias da
# privacidade (/api/rotinas). O Cron da Vercel manda "Authorization: Bearer <CRON_SECRET>". Sem ele (ou com menos de 32
# caracteres), as rotinas ficam desligadas. Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
# SECRETO, 32+ caracteres (opcional): chave do HMAC do IP no freio diário de conversas por IP (o banco nunca vê o IP).
# Vazio: usa a SUPABASE_CHAVE_SECRETA
FREIO_SEGREDO=
# SECRETO (20–64 letras, números, - ou _), opcional: tópico do ntfy.sh para os alertas da rotina diária chegarem no
# celular (grátis, sem conta: instale o app ntfy e inscreva-se neste tópico). Vazio: os alertas ficam só no painel
ALERTA_NTFY_TOPICO=
# SECRETO (tk_…), opcional: token de uma conta grátis do ntfy com o tópico reservado (aí ninguém mais lê ou escreve nele)
ALERTA_NTFY_TOKEN=

# ---------- Cloudflare (plano da migração, 2026-10-21) ----------
# só na Cloudflare: "previa" nas prévias; QUALQUER outra coisa (ou vazio) = produção (fechado por padrão). A Cloudflare é
# reconhecida pelo próprio runtime, então esquecer esta variável nunca abre nada
BZ_AMBIENTE=
# como as direções saem: manual (fila do dono, padrão enquanto não há verba para a API) ou api
BZ_DIRECOES=manual
# anti-robô (Cloudflare Turnstile): chave do site (pública) e segredo (SECRETO). Obrigatórias na produção
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# formas de pagamento: pix (padrão e único no lançamento) ou pix,cartao. Ausente ou inválido = só Pix fora do servidor local
MP_METODOS=pix
# a entrega (material e link do pedido, PR 3b-2): ligada = abre o material e o link do pedido; vazio = desligado. Só liga com o 3b-3 no ar
BZ_ENTREGA=
