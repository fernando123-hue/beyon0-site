# ==========================================================================
# Variáveis de ambiente do site Beyon Zero — SÓ OS NOMES, NUNCA OS VALORES.
# Os valores ficam na Vercel (Settings > Environment Variables) e, na
# próxima fase, no Infisical. Nenhuma delas vai para o navegador.
# Detalhes: docs/fundacao/02-OPERACAO.md
# ==========================================================================

# Supabase — Project Settings > API Keys
SUPABASE_URL=
# chave publicável (sb_publishable_...): o backend a usa com o JWT do usuário, então o RLS vale
SUPABASE_CHAVE_PUBLICA=
# chave SECRETA (sb_secret_...): ignora o RLS. Só servidor, só métricas anônimas e tarefas do sistema
SUPABASE_CHAVE_SECRETA=

# painel de métricas (/painel): 32+ caracteres aleatórios
# node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
PAINEL_CHAVE=

# opcional: outros hosts aceitos no /api/evento, separados por vírgula (ex.: www.dominio.com.br)
METRICAS_HOSTS=

# ---------- Fase 2: agente de vendas (/orcamento) ----------
# chave da API da Anthropic (o modelo): SÓ servidor. Sem ela, a conversa responde "indisponível" e oferece o WhatsApp.
ANTHROPIC_API_KEY=
# gateway de pagamento: vazio = pagamento online desligado (o sinal é combinado pelo WhatsApp).
# "simulado" só em preview/teste (nunca liga com VERCEL_ENV=production). Asaas/Mercado Pago: adaptador pendente.
PAGAMENTO_GATEWAY=
# segredo do gateway simulado (32+ caracteres): só em preview
PAGAMENTO_SIMULADO_SEGREDO=
# endereço público do site (links de retorno do pagamento), ex.: https://beyon0-site.vercel.app
SITE_URL=
