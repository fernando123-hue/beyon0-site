{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // produção (Worker beyon-zero-site, branch producao). Uma conta, dois Workers: a conta vem do token do Builds, nunca account_id aqui.
  "name": "beyon-zero-site",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["nodejs_compat"],
  // o domínio é SÓ da produção (Custom Domain: a Cloudflare cria o DNS e o certificado). Sem www: o www é da Redirect Rule da zona (plano § 7.1)
  "routes": [{ "pattern": "beyonzero.com.br", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "publico",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "triggers": { "crons": ["23 * * * *", "41 6 * * *"] },
  // BZ_DIRECOES: os 3 modelos saem pela API, na hora (dono, 15/11; antes "manual", a fila do dono, desde 08/10). Sem a chave da Anthropic
  // o código cai sozinho na fila manual (api/_ia/config.mjs, modoDirecoes); o staging e as prévias seguem "manual" (IA simulada, sem gasto)
  "vars": { "BZ_AMBIENTE": "producao", "MP_AMBIENTE": "producao", "MP_METODOS": "pix", "BZ_DIRECOES": "api", "MP_3DS": "", "METRICAS_HOSTS": "",
    // o aviso ao dono por e-mail (api/_aviso.mjs) até existir o app com push; o remetente (avisos@ do domínio) fica no código; o destino é o e-mail público da empresa e precisa estar
    // verificado no Email Routing da zona. Só a produção avisa: o staging (env.previa) não tem o binding nem estes endereços
    "AVISO_PARA": "contato.beyon.zero@gmail.com",
    // o modo sombra do JEV (F3, api/_classificador/sombra.mjs): só MEDE cada turno do Zero, nunca muda a resposta; teto do dia
    // US$ 0,30 no código. Só a produção liga: o staging usa a IA simulada. Precisa de app.jev_sombra no banco (migration de 10/11)
    "JEV_SOMBRA": "1",
    // o microfone do Zero (api/_vendas/voz.mjs): a voz vira texto pelo Whisper do Workers AI (binding AI); "1" liga o botão Falar.
    // DESLIGADO na produção até o teste na prévia (docs/PROCESSO.md do PR): ninguém provou ainda que o Whisper decodifica o áudio
    // do Safari (mp4/AAC) e do Chrome (webm/Opus); só depois disso um PR de uma linha troca "" por "1"
    "BZ_VOZ": "",
    // o TESTE DO PIX DE R$ 0,01 do painel do dono (api/_pagamentos/teste-pix.mjs): rotas só com a chave do painel E com "1" aqui.
    // VAZIA por padrão (fechado): só se liga pelo painel da Cloudflare (variável de ambiente) no momento do teste do dono, e se desliga depois
    "BZ_TESTE_PIX": "" },
  "ai": { "binding": "AI" },
  "send_email": [{ "name": "AVISO_EMAIL", "destination_address": "contato.beyon.zero@gmail.com" }],
  "observability": { "enabled": true, "logs": { "enabled": true, "head_sampling_rate": 1 }, "traces": { "enabled": true } },
  "env": {
    // o Worker das PRÉVIAS (mesma conta): main = staging fixo (publicado com --env previa); outras branches = versões de prévia, também com --env previa
    "previa": {
      // routes é HERDÁVEL: sem esta linha, depois do PR C o staging tentaria prender beyonzero.com.br (2ª revisão, ALTO-1)
      "routes": [],
      "workers_dev": true,
      "preview_urls": true,
      "triggers": { "crons": ["23 * * * *", "41 6 * * *"] },
      "ai": { "binding": "AI" },
      // BZ_PLANTA: a planta viva e o mapa do caso ficam LIGADOS só na prévia (dono, chat 20/11) para ele ver no celular; na produção segue desligada (decisão de 07/11)
      "vars": { "BZ_AMBIENTE": "previa", "MP_AMBIENTE": "teste", "MP_METODOS": "pix", "BZ_DIRECOES": "manual", "MP_3DS": "", "METRICAS_HOSTS": "", "BZ_IA": "simulada", "BZ_VOZ": "1", "BZ_PLANTA": "ligada" },
      // as prévias de branch NÃO herdam vars: sem este bloco elas rodariam como produção (2ª revisão, ALTO-2)
      "previews": {
        "vars": { "BZ_AMBIENTE": "previa", "MP_AMBIENTE": "teste", "MP_METODOS": "pix", "BZ_DIRECOES": "manual", "MP_3DS": "", "METRICAS_HOSTS": "", "BZ_IA": "simulada", "BZ_VOZ": "1", "BZ_PLANTA": "ligada" }
      }
    }
  }
}
